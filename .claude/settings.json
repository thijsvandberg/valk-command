{
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.slack.com/*"
    },
    {
      "serverUrl": "https://gmail.mcp.claude.com/*"
    },
    {
      "serverUrl": "https://gcal.mcp.claude.com/*"
    },
    {
      "serverUrl": "https://mcp.atlassian.com/*"
    },
    {
      "serverUrl": "https://mcp.canva.com/*"
    },
    {
      "serverUrl": "https://mcp.notion.com/*"
    },
    {
      "serverUrl": "https://mcp.figma.com/*"
    },
    {
      "serverUrl": "https://docuseal.com/*"
    },
    {
      "serverUrl": "https://api.ahrefs.com/*"
    },
    {
      "serverUrl": "https://mcp.neon.tech/*"
    }
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/metadata-updater.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE 'git[[:space:]]+push'; then echo 'Pre-push build check...'; npm run build 2>&1 | tail -10; fi",
            "timeout": 120000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE '\\.(tsx?|jsx?)\"'; then LOCK=/tmp/valk-test.lock; find \"$LOCK\" -maxdepth 0 -mmin +1 -exec rm -rf {} \\; 2>/dev/null; if mkdir \"$LOCK\" 2>/dev/null; then trap 'rm -rf \"$LOCK\"' EXIT; npm run test 2>&1 | tail -5; rm -rf \"$LOCK\"; else echo 'Test already running, skipped'; fi; fi",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
