{
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.slack.com/*"
    },
    {
      "serverUrl": "https://gmail.mcp.claude.com/*"
    },
    {
      "serverUrl": "https://gcal.mcp.claude.com/*"
    },
    {
      "serverUrl": "https://mcp.atlassian.com/*"
    },
    {
      "serverUrl": "https://mcp.canva.com/*"
    },
    {
      "serverUrl": "https://mcp.notion.com/*"
    },
    {
      "serverUrl": "https://mcp.figma.com/*"
    },
    {
      "serverUrl": "https://docuseal.com/*"
    },
    {
      "serverUrl": "https://api.ahrefs.com/*"
    },
    {
      "serverUrl": "https://mcp.neon.tech/*"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/scripts/git-branch-switch-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE '\\.(tsx?|jsx?)\"'; then bash \"$CLAUDE_PROJECT_DIR/tools/scripts/run-tests.sh\" skip --changed 2>&1 | tail -8; fi",
            "timeout": 120000
          }
        ]
      }
    ]
  }
}
