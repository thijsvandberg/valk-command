# =============================================================================
# Bridge - Environment Variables
# Copy this file to .env.local and fill in your values.
# See src/lib/env.ts for the Zod validation schema.
# =============================================================================

# -- Database -----------------------------------------------------------------
DB_PATH=sqlite.db                        # SQLite database file path

# -- Jira Integration ---------------------------------------------------------
JIRA_CLOUD_ID=                           # Atlassian cloud instance ID (preferred)
JIRA_BASE_URL=                           # Fallback direct Jira URL if CLOUD_ID not set
JIRA_EMAIL=                              # Email for Jira Basic auth
JIRA_API_TOKEN=                          # API token from id.atlassian.com
JIRA_PROJECT_KEY=VPL                     # Jira project key (default: VPL)
JIRA_BOARD_ID=                           # Jira board ID for sprint queries

# -- Jira UI Links ------------------------------------------------------------
NEXT_PUBLIC_JIRA_BASE_URL=https://your-org.atlassian.net  # Used in UI links to Jira
NEXT_PUBLIC_JIRA_PROJECT_KEY=VPL          # Project key used to linkify ticket refs in descriptions (client-side)
NEXT_PUBLIC_JIRA_BOARD_ID=                # Board ID for "Open in Jira" sprint backlog links (client-side)

# -- Workspace Agent ----------------------------------------------------------
VALK_AGENT_URL=http://localhost:3001     # valk-agent base URL
VALK_AGENT_KEY=                          # Bearer token for agent auth (required for agent features)

# -- Bitbucket Cloud (optional, for dev-info panel) ---------------------------
BITBUCKET_WORKSPACE=                     # Bitbucket workspace slug
BITBUCKET_REPO_SLUG=                     # Comma-separated repo slugs (e.g. repo-a,repo-b)
BITBUCKET_EMAIL=                         # Falls back to JIRA_EMAIL if not set
BITBUCKET_APP_PASSWORD=                  # App password for Bitbucket auth
BITBUCKET_API_TOKEN=                     # Alternative to BITBUCKET_APP_PASSWORD

# -- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100 # Public app URL (used for internal API calls)
BT_NEXT_SPRINT_ID=                       # Next sprint ID override

# -- Confluence (optional, for knowledge base integration) --------------------
CONFLUENCE_BASE_URL=                     # Atlassian Confluence base URL (e.g. https://your-org.atlassian.net)
CONFLUENCE_EMAIL=                        # Email for Confluence Basic auth (falls back to JIRA_EMAIL)
CONFLUENCE_API_TOKEN=                    # API token for Confluence (can reuse Jira token if same Atlassian org)
CONFLUENCE_SPACE_KEY=                    # Confluence space key to query

# -- Auth (Clerk) -------------------------------------------------------------
CLERK_SECRET_KEY=                        # Clerk secret key (from dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=       # Clerk publishable key (from dashboard.clerk.com)
CLERK_ORG_ID=                            # Clerk org ID for Bridge (restricts access to org members only)
NEXT_PUBLIC_CLERK_ORG_ID=               # Same value — needed client-side for org auto-switch on login
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login     # Where Clerk redirects on sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login     # Where Clerk redirects on sign-up
# Dev bypass: visit /api/dev/bypass in the browser to skip Clerk auth locally.
# No env var needed — the bypass is activated by cookie, not config.

# -- Logging ----------------------------------------------------------------
LOG_LEVEL=                               # debug | info | warn | error (default: info in prod, debug in dev)
